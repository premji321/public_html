<style>
:root {
    --navy: #102747;
    --blue: #1769aa;
    --gold: #f4b942;
    --bg: #f4f7fb;
    --text: #26364a;
    --muted: #68778a;
    --border: #dce5ef;
    --white: #ffffff;
    --green: #14804a;
    --red: #d93636;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
    scroll-padding-top: 90px;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background: var(--bg);
    color: var(--text);
    line-height: 1.6;
}

/* HEADER */

.header {
    background: var(--navy);
    color: var(--white);
    min-height: 70px;
    padding: 14px 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 15px;
    position: sticky;
    top: 0;
    z-index: 1000;
    box-shadow: 0 3px 12px #10274722;
}

.logo {
    color: white;
    text-decoration: none;
    font-size: 23px;
    font-weight: 800;
}

.logo span {
    color: var(--gold);
}

.header-actions {
    display: flex;
    align-items: center;
    gap: 10px;
}

.home-link {
    background: var(--blue);
    color: white;
    padding: 9px 15px;
    border-radius: 7px;
    text-decoration: none;
    font-size: 14px;
}

.menu-toggle {
    display: none;
    background: transparent;
    border: 1px solid #ffffff66;
    color: white;
    padding: 7px 12px;
    border-radius: 6px;
    font-size: 21px;
    cursor: pointer;
}

/* LAYOUT */

.layout {
    display: grid;
    grid-template-columns: 265px minmax(0, 1fr);
    min-height: calc(100vh - 70px);
}

/* SIDEBAR */

.sidebar {
    background: white;
    border-right: 1px solid var(--border);
    padding: 22px 14px;
    height: calc(100vh - 70px);
    position: sticky;
    top: 70px;
    overflow-y: auto;
}

.sidebar-title {
    font-size: 12px;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 1.2px;
    font-weight: 800;
    padding: 0 12px;
    margin-bottom: 12px;
}

.menu-list {
    list-style: none;
}

.menu-list li {
    margin-bottom: 5px;
}

.menu-list a {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 11px 12px;
    color: var(--text);
    text-decoration: none;
    font-size: 14px;
    border-radius: 7px;
    transition: background 0.2s;
}

.menu-list a:hover,
.menu-list a.active {
    background: #eaf3ff;
    color: var(--blue);
    font-weight: 700;
}

.menu-list .section-label {
    font-size: 11px;
    color: var(--muted);
    padding: 18px 12px 5px;
    font-weight: 800;
    text-transform: uppercase;
}

/* BLINKING MOCK TEST LINK */

.mock-menu-link {
    color: white !important;
    font-weight: 800 !important;
    background: var(--red);
    border: 1px solid #b91c1c;
    box-shadow: 0 0 0 0 #d9363660;
    animation: mockPulse 1.5s infinite;
}

.mock-menu-link:hover {
    background: #b91c1c !important;
    color: white !important;
}

.new-badge {
    margin-left: auto;
    background: white;
    color: var(--red);
    padding: 1px 6px;
    border-radius: 10px;
    font-size: 10px;
    font-weight: 800;
}

@keyframes mockPulse {
    0% {
        box-shadow: 0 0 0 0 #d9363660;
        transform: scale(1);
    }
    50% {
        box-shadow: 0 0 0 5px #d9363600;
        transform: scale(1.015);
    }
    100% {
        box-shadow: 0 0 0 0 #d9363600;
        transform: scale(1);
    }
}

/* MAIN CONTENT */

.content {
    min-width: 0;
    padding: 30px;
    max-width: 1250px;
    width: 100%;
    margin: 0 auto;
}

.breadcrumb {
    font-size: 13px;
    color: var(--muted);
    margin-bottom: 18px;
}

.breadcrumb a {
    color: var(--blue);
    text-decoration: none;
}

/* HERO */

.hero {
    background: linear-gradient(125deg, #102747, #1769aa);
    color: white;
    padding: 35px;
    border-radius: 15px;
    margin-bottom: 25px;
}

.hero-label {
    display: inline-block;
    background: #ffffff20;
    padding: 5px 11px;
    border-radius: 20px;
    font-size: 12px;
    margin-bottom: 12px;
}

.hero h1 {
    font-size: clamp(27px, 3vw, 39px);
    line-height: 1.25;
    margin-bottom: 14px;
}

.hero p {
    max-width: 720px;
    color: #e5efff;
    font-size: 15px;
}

.hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 22px;
}

.btn {
    display: inline-block;
    padding: 11px 17px;
    border-radius: 7px;
    text-decoration: none;
    font-size: 14px;
    font-weight: 700;
}

.btn-light {
    background: white;
    color: var(--navy);
}

.btn-outline {
    border: 1px solid #ffffff80;
    color: white;
}

/* MOCK TEST FEATURE CARD */

.mock-feature {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 22px;
    background: linear-gradient(115deg, #fff4f4, #ffffff);
    border: 2px solid #f2b5b5;
    border-radius: 14px;
    padding: 24px;
    margin-bottom: 28px;
    animation: cardPulse 2.5s infinite;
}

@keyframes cardPulse {
    0%, 100% {
        border-color: #f2b5b5;
    }
    50% {
        border-color: #d93636;
    }
}

.mock-feature h2 {
    color: #b91c1c;
    font-size: 23px;
    margin-bottom: 7px;
}

.mock-feature p {
    color: var(--muted);
    font-size: 14px;
}

.mock-button {
    flex-shrink: 0;
    display: inline-block;
    background: var(--red);
    color: white;
    padding: 13px 20px;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 800;
    animation: buttonPulse 1.5s infinite;
}

.mock-button:hover {
    background: #b91c1c;
}

@keyframes buttonPulse {
    0%, 100% {
        box-shadow: 0 0 0 0 #d9363650;
    }
    50% {
        box-shadow: 0 0 0 7px #d9363600;
    }
}

/* QUICK CARDS */

.quick-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 15px;
    margin-bottom: 30px;
}

.quick-card {
    display: block;
    background: white;
    padding: 19px;
    border: 1px solid var(--border);
    border-radius: 11px;
    text-decoration: none;
    color: var(--text);
    transition: 0.2s;
}

.quick-card:hover {
    transform: translateY(-3px);
    border-color: var(--blue);
    box-shadow: 0 6px 18px #1027470d;
}

.quick-icon {
    font-size: 26px;
    margin-bottom: 8px;
}

.quick-card h3 {
    font-size: 16px;
    margin-bottom: 5px;
}

.quick-card p {
    font-size: 13px;
    color: var(--muted);
}

/* SECTIONS */

.section {
    background: white;
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 25px;
    margin-bottom: 24px;
    scroll-margin-top: 90px;
}

.section h2 {
    color: var(--navy);
    font-size: 23px;
    margin-bottom: 8px;
}

.section-intro {
    color: var(--muted);
    font-size: 14px;
    margin-bottom: 20px;
}

.notice-box {
    background: #eaf3ff;
    border-left: 4px solid var(--blue);
    padding: 14px 16px;
    border-radius: 5px;
    font-size: 14px;
    margin: 16px 0;
}

.info-box {
    background: #fff8e8;
    border-left: 4px solid var(--gold);
    padding: 14px 16px;
    border-radius: 5px;
    font-size: 14px;
    margin: 16px 0;
}

.data-table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 14px;
    font-size: 14px;
}

.data-table th,
.data-table td {
    border: 1px solid var(--border);
    padding: 12px;
    text-align: left;
    vertical-align: top;
}

.data-table th {
    background: #eaf3ff;
    color: var(--navy);
}

.data-table tr:nth-child(even) {
    background: #fafcff;
}

.topic-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
}

.topic-card {
    border: 1px solid var(--border);
    padding: 15px;
    border-radius: 8px;
}

.topic-card h3 {
    color: var(--blue);
    font-size: 16px;
    margin-bottom: 5px;
}

.topic-card p {
    color: var(--muted);
    font-size: 13px;
}

.action-link {
    display: inline-block;
    margin-top: 13px;
    color: var(--blue);
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
}

.action-link:hover {
    text-decoration: underline;
}

.subject-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    list-style: none;
}

.subject-list a {
    display: block;
    padding: 12px;
    background: #f7faff;
    border: 1px solid var(--border);
    border-radius: 7px;
    color: var(--text);
    text-decoration: none;
    font-size: 14px;
}

.subject-list a:hover {
    color: var(--blue);
    border-color: var(--blue);
}

.footer {
    text-align: center;
    padding: 24px;
    color: var(--muted);
    font-size: 13px;
}

/* RESPONSIVE */

@media (max-width: 900px) {
    .layout {
        grid-template-columns: 1fr;
    }

    .sidebar {
        display: none;
        height: auto;
        max-height: 70vh;
        position: fixed;
        top: 70px;
        left: 0;
        width: 290px;
        z-index: 999;
        box-shadow: 8px 10px 25px #0002;
    }

    .sidebar.open {
        display: block;
    }

    .menu-toggle {
        display: inline-block;
    }

    .content {
        padding: 20px;
    }

    .quick-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

@media (max-width: 560px) {
    .header {
        padding: 12px 15px;
    }

    .logo {
        font-size: 19px;
    }

    .home-link {
        display: none;
    }

    .content {
        padding: 13px;
    }

    .hero {
        padding: 24px 20px;
    }

    .section {
        padding: 18px;
    }

    .quick-grid,
    .topic-grid,
    .subject-list {
        grid-template-columns: 1fr;
    }

    .mock-feature {
        flex-direction: column;
        align-items: flex-start;
    }

    .mock-button {
        width: 100%;
        text-align: center;
    }

    .data-table {
        font-size: 12px;
    }

    .data-table th,
    .data-table td {
        padding: 8px;
    }
}

/* Respect reduced-motion preferences */
@media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
        animation: none !important;
        scroll-behavior: auto !important;
    }
}
</style>
